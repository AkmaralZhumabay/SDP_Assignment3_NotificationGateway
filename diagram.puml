@startuml

title Multi-Channel Notification Gateway - Bridge Pattern

skinparam classAttributeIconSize 0

interface MessageSender <<Implementor>> {
    +sendMessage(recipient: String, title: String, body: String): boolean
    +isAvailable(): boolean
    +getChannelName(): String
}

class TelegramMessageSender <<Concrete Implementor>>
class EmailMessageSender <<Concrete Implementor>>
class SmsMessageSender <<Concrete Implementor>>
class KafkaEventSender <<Concrete Implementor>>
class PushNotificationSender <<Concrete Implementor>>

MessageSender <|.. TelegramMessageSender
MessageSender <|.. EmailMessageSender
MessageSender <|.. SmsMessageSender
MessageSender <|.. KafkaEventSender
MessageSender <|.. PushNotificationSender

abstract class Notification <<Abstraction>> {
    #sender: MessageSender
    #Notification(sender: MessageSender)
    +setSender(sender: MessageSender): void
    {abstract} +send(recipient: String, message: String): void
}

class UrgentNotification <<Refined Abstraction>> {
    -fallbackSender: MessageSender
    +setFallbackSender(sender: MessageSender): void
    +send(recipient: String, message: String): void
}

class EncryptedNotification <<Refined Abstraction>> {
    +send(recipient: String, message: String): void
}

class ScheduledBatchNotification <<Refined Abstraction>> {
    -recipients: List<String>
    +send(recipient: String, message: String): void
}

class MarketingNotification <<Refined Abstraction>> {
    +send(recipient: String, message: String): void
}

Notification <|-- UrgentNotification
Notification <|-- EncryptedNotification
Notification <|-- ScheduledBatchNotification
Notification <|-- MarketingNotification

Notification o--> MessageSender : Bridge
UrgentNotification o--> MessageSender : fallback

@enduml